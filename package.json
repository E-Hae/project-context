{
  "name": "project-context-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Evidence-first local MCP server and CLI for codebase discovery, search, and C# relationship tracing.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-search",
    "codebase",
    "semantic-search",
    "roslyn",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/E-Hae/project-context.git"
  },
  "bugs": {
    "url": "https://github.com/E-Hae/project-context/issues"
  },
  "homepage": "https://github.com/E-Hae/project-context#readme",
  "files": [
    "dist/src",
    "workers/roslyn/bin/Release/net8.0",
    "workers/roslyn/Program.cs",
    "workers/roslyn/ProjectContext.Roslyn.csproj",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "project-context": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:roslyn": "dotnet build workers/roslyn/ProjectContext.Roslyn.csproj -c Release",
    "build:all": "npm run build && npm run build:roslyn",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "test:roslyn": "npm run build && npm run build:roslyn && node --test dist/tests/roslyn-worker.integration.test.js",
    "status": "node dist/src/cli.js status",
    "verify": "npm run typecheck && npm test && npm run test:roslyn",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "minimatch": "10.2.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
