{
  "name": "project-context-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local MCP server for project code, documents, and handoff context.",
  "bin": {
    "project-context": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:roslyn": "dotnet build workers/roslyn/ProjectContext.Roslyn.csproj -c Release",
    "build:all": "npm run build && npm run build:roslyn",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "test:roslyn": "npm run build && npm run build:roslyn && node --test dist/tests/roslyn-worker.integration.test.js",
    "status": "node dist/src/cli.js status"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "minimatch": "10.2.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
