{
  "name": "project-context-mcp",
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "description": "Evidence-first local MCP server and CLI for codebase discovery, search, and source-backed tracing adapters.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-search",
    "codebase",
    "semantic-search",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/E-Hae/project-context.git"
  },
  "bugs": {
    "url": "https://github.com/E-Hae/project-context/issues"
  },
  "homepage": "https://github.com/E-Hae/project-context#readme",
  "files": [
    "dist/src",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "workspaces": [
    "adapters/*"
  ],
  "exports": {
    "./trace-adapter": "./dist/src/trace-adapter.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "project-context-mcp": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test \"dist/tests/*.test.js\"",
    "status": "node dist/src/cli.js status",
    "verify": "npm run typecheck && npm test",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "minimatch": "10.2.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
