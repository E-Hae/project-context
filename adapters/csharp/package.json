{
  "name": "project-context-mcp-csharp",
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "description": "C# Roslyn tracing adapter for project-context-mcp.",
  "files": [
    "dist/src",
    "workers/roslyn/bin/Release/net8.0",
    "workers/roslyn/Program.cs",
    "workers/roslyn/ProjectContext.Roslyn.csproj",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm --prefix ../.. run build",
    "build": "tsc -p tsconfig.json",
    "build:roslyn": "dotnet build workers/roslyn/ProjectContext.Roslyn.csproj -c Release",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test \"dist/tests/*.test.js\"",
    "test:roslyn": "npm run build && npm run build:roslyn && node --test dist/tests/worker-client.integration.test.js",
    "verify": "npm run typecheck && npm test && npm run test:roslyn",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "project-context-mcp": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "project-context-mcp": "file:../..",
    "typescript": "6.0.3"
  }
}
